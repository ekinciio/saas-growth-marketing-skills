  "type_meaning": {
    "search": "Builds an index used to show and cite pages in search results or AI answers.",
    "training": "Collects content that may be used to train models. Blocking it is a policy choice, not a visibility fix.",
    "user-fetch": "Fetches a page because a person asked an assistant to. Operators say several of these may ignore robots.txt.",
    "control": "A robots.txt token that changes how another crawler's data is used. It does not crawl.",
    "other": "Ads review, link previews, research or customer-requested crawls."
  },
  "priority_meaning": {
    "critical": "Blocking it removes the site from a search engine and the AI answers built on it.",
    "high": "Search crawler of an AI assistant; blocking it removes or limits citations in that assistant.",
    "medium": "User-triggered fetcher; robots.txt may not apply, so control sits at the CDN or WAF.",
    "policy": "Training or usage control; the owner decides. Never scored as good or bad.",
    "info": "Reported for completeness."
  },
